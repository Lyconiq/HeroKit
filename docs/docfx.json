{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../HeroKit",
          "files": [
            "HeroKit.csproj"
          ]
        },
        {
          "src": "../HeroKit.FluentValidation",
          "files": [
            "HeroKit.FluentValidation.csproj"
          ]
        },
        {
          "src": "../HeroKit.FileTypes",
          "files": [
            "HeroKit.FileTypes.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "robots.txt"
        ]
      }
    ],
    "output": "_site",
    "sitemap": {
      "baseUrl": "https://herokit.lyconiq.com/",
      "changefreq": "weekly"
    },
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "HeroKit",
      "_appTitle": "HeroKit",
      "_appFooter": "<span>HeroKit · MIT License · Built with care for .NET developers · <a href=\"https://github.com/Lyconiq/HeroKit\">GitHub</a> · <a href=\"https://www.nuget.org/packages/HeroKit\">NuGet</a></span>",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/Lyconiq/HeroKit",
        "branch": "master"
      },
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/favicon.png",
      "_enableNewTab": true,
      "_disableContribution": false,
      "_lang": "en"
    }
  }
}
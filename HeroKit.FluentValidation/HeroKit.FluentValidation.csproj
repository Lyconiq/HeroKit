<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <!-- Fails the pack when the public API breaks compatibility with the last release. Update after each release. -->
        <PackageValidationBaselineVersion>3.6.0</PackageValidationBaselineVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Label="Package">
        <PackageId>HeroKit.FluentValidation</PackageId>
        <Title>HeroKit.FluentValidation</Title>
        <Authors>Emre Akdemir</Authors>
        <Company>Lyconiq</Company>
        <Description>FluentValidation rules for HeroKit: Turkish identity and tax numbers, IBAN, Turkish phone numbers, postal codes, vehicle plates, card numbers and safe file uploads.</Description>
        <PackageTags>fluentvalidation;validation;turkish;turkiye;tckn;vkn;iban;herokit</PackageTags>
        <PackageProjectUrl>https://herokit.lyconiq.com</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Lyconiq/HeroKit</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>herokit.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>SafeUpload(openRead, fileName, policy) checks uploaded files of any type with HeroKit.FileTypes. The package now depends on HeroKit.FileTypes. Requires FluentValidation 12.0.0 or later.</PackageReleaseNotes>
        <Copyright>Copyright © 2023-2026 Emre Akdemir, Lyconiq</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup Label="SourceLink">
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="../HeroKit/herokit.png" Pack="true" PackagePath="/" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.2.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HeroKit\HeroKit.csproj" />
        <ProjectReference Include="..\HeroKit.FileTypes\HeroKit.FileTypes.csproj" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <!-- Fails the pack when the public API breaks compatibility with the last release. Update after each release. -->
        <PackageValidationBaselineVersion>3.5.0</PackageValidationBaselineVersion>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Label="Package">
        <PackageId>HeroKit.FileTypes</PackageId>
        <Title>HeroKit.FileTypes</Title>
        <Authors>Emre Akdemir</Authors>
        <Company>Lyconiq</Company>
        <Description>Dependency-free file type detection for .NET: magic bytes for about 70 formats (Office and OpenDocument inside ZIP, HEIC/AVIF/MP4 brands, WebP, JPEG XL), extension and MIME mapping, content vs. extension checks and safe upload checks (executables, scripts, double extensions, SVG with script). Register your own file types and upload rules. Native AOT compatible.</Description>
        <PackageTags>mime;mimetype;content-type;file-type;magic-bytes;file-signature;upload;security;aot;herokit</PackageTags>
        <PackageProjectUrl>https://herokit.emreakdemir.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Lyconiq/HeroKit</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>herokit.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Macro-enabled Office detection (Docm, Xlsm, Pptm, HasMacros) with UploadPolicy.AllowMacros; ZIP central directory reading from seekable streams, so large DOCX/XLSX/PPTX files are recognized. The docm/xlsm/pptm extensions now map to the macro-enabled types.</PackageReleaseNotes>
        <Copyright>Copyright © 2023-2026 Emre Akdemir</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <PropertyGroup Label="SourceLink">
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="../HeroKit/herokit.png" Pack="true" PackagePath="/" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
